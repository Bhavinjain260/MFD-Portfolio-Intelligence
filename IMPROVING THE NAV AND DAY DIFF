## Update Your Download Check Logic

```python
def download_and_save_nav_if_needed(force: bool = False) -> dict:
    """
    Only fetch if:
    1. Today is a trading day, AND
    2. Either force=True OR (no file for today's expected NAV OR file is stale)
    """
    now = datetime.now()
    today = now.date()
    
    # ── Step 1: Is today a trading day? ──
    if not is_trading_day(today):
        log.info(
            "[AMFI] Today (%s) is not a trading day. Skipping download.",
            today.strftime("%A, %Y-%m-%d")
        )
        return {
            "ran": False,
            "ok": True,
            "reason": f"Non-trading day ({today.strftime('%a')})",
            "is_holiday": True
        }
    
    # ── Step 2: Expected NAV date for a download TODAY ──
    expected_nav_date = get_expected_nav_date(today, is_domestic=True)
    
    # ── Step 3: Do we already have a file with that NAV date? ──
    if not force and _have_snapshot_for_date(expected_nav_date.strftime("%Y-%m-%d")):
        size = os.path.getsize(_snapshot_path(expected_nav_date.strftime("%Y-%m-%d")))
        cutoff = _last_passed_cutoff_today(now)
        
        if cutoff is None:
            log.info("[AMFI] Before first cutoff — keeping existing file")
            return {"ran": False, "ok": True, "reason": "before first cutoff", "bytes": size}
        
        file_path = _snapshot_path(expected_nav_date.strftime("%Y-%m-%d"))
        file_mtime = datetime.fromtimestamp(os.path.getmtime(file_path))
        cutoff_dt = datetime.combine(now.date(), cutoff)
        
        if file_mtime >= cutoff_dt:
            log.info("[AMFI] File fresh for cutoff %s", cutoff)
            return {
                "ran": False,
                "ok": True,
                "reason": f"file fresh for {cutoff} cutoff",
                "bytes": size
            }
        
        log.info("[AMFI] File stale, redownloading")
    
    # ── Step 4: Download ──
    try:
        result = download_and_save_nav(timeout=30)
        return {"ran": True, **result}
    except Exception as e:
        log.exception("[AMFI] Download failed")
        return {"ran": True, "ok": False, "reason": f"download failed: {e}"}
