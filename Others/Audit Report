def safe_parse_dates(df: pd.DataFrame, date_cols: List[str], dayfirst: bool = False) -> pd.DataFrame:
    """Parse date columns and remove unparseable rows."""
    df = df.copy()
    for col in date_cols:
        if col in df.columns:
            df[col] = pd.to_datetime(df[col], errors="coerce", dayfirst=dayfirst)
    return df.dropna(subset=[c for c in date_cols if c in df.columns])
```

