            df,
            gridOptions=gb.build(),
            height=height,
            update_mode=GridUpdateMode.NO_UPDATE,
            fit_columns_on_grid_load=True,
            theme="alpine-dark" if st.context.theme.type == "dark" else "alpine",
            key=key or f"table_{id(df)}"
        )
    except ImportError:
        st.dataframe(df, width="stretch", hide_index=True, column_config=columns_config)
