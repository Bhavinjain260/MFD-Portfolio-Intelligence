**Solution:** Consolidate into one formatter
```python
class CurrencyFormatter:
    """Unified currency formatting with locale & scale support."""
    
    SCALES = {
        "full": 1,
        "crores": 1_00_00_000,
        "lakhs": 1_00_000,
    }
    
    @staticmethod
    def format(value, scale: str = "auto", decimals: int = 2, currency: str = "Rs") -> str:
        """Format currency with automatic scale selection."""
        if pd.isna(value) or value is None:
            return f"{currency} -"
        
        try:
            amount = float(value)
            if scale == "auto":
                if abs(amount) >= 1_00_00_000:
                    amount, unit = amount / 1_00_00_000, "Cr"
                elif abs(amount) >= 1_00_000:
                    amount, unit = amount / 1_00_000, "L"
                else:
                    unit = ""
                return f"{currency} {amount:,.{decimals}f}{' ' + unit if unit else ''}"
            else:
                scale_factor = CurrencyFormatter.SCALES.get(scale, 1)
                return f"{currency} {amount / scale_factor:,.{decimals}f}"
        except (TypeError, ValueError):
            return f"{currency} -"
```

